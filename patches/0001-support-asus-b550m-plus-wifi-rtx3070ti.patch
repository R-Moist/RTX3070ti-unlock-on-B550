+/* Location-independent acceptance: any well-formed path carrying exactly one
+ * GPT/MBR HARDDRIVE node, i.e. a real disk partition, with no specific GUID.
+ * Used where the image may legitimately live on the internal ESP, a USB stick,
+ * or a folder invoked from the UEFI Shell. Malformed, repeated or absent HD
+ * nodes are still refused. */
+static inline BOOLEAN GuPathIsHardDrive(const EFI_DEVICE_PATH_PROTOCOL *Path) {
+  UINTN total=0,hd=0;
+  if(!Path)return FALSE;
+  for(UINTN nodes=0;nodes<64 && total+4<=4096;nodes++) {
+    UINTN n=Path->Length[0]+((UINTN)Path->Length[1]<<8);
+    if(n<4 || n>4096-total)return FALSE;
+    if(Path->Type==END_DEVICE_PATH_TYPE) {
+      if(n!=4 || Path->SubType!=END_ENTIRE_DEVICE_PATH_SUBTYPE)return FALSE;
+      return hd==1;
+    }
+    if(Path->Type==MEDIA_DEVICE_PATH && Path->SubType==MEDIA_HARDDRIVE_DP) {
+      if(n!=sizeof(HARDDRIVE_DEVICE_PATH) || ++hd!=1)return FALSE;
+    }
+    total+=n;Path=(const VOID *)((const UINT8 *)Path+n);
+  }
+  return FALSE;
+}
