+  if(matches!=1){GuFree(handles);return matches?EFI_COMPROMISED_DATA:EFI_NOT_FOUND;}
+  EFI_DEVICE_PATH_PROTOCOL *base=NULL;UINTN baseBytes=0;
+  if(EFI_ERROR(Gu.bs->HandleProtocol(win,&PathGuid,(VOID **)&base)) || !base){GuFree(handles);return EFI_UNSUPPORTED;}
+  if(!GuInspectPath(base,NULL,&baseBytes,NULL,NULL) || baseBytes<4){GuFree(handles);return EFI_UNSUPPORTED;}
